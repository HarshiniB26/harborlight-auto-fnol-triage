# Local development does not need these values. The AWS path reads them from
# the EC2 instance role. Do not put real credentials in this file.

AWS_REGION=us-east-1

# Leave the bucket empty to keep reading data/dev/dataset.json.
FNOL_DATASET_BUCKET=
FNOL_DATASET_KEY=dataset.json

# Leave both empty to keep SQLite and the workbench JSON file.
FNOL_DATABASE_URL=
FNOL_DATABASE_SECRET_ARN=
FNOL_APP_SECRET_ARN=

# Set FNOL_AUTH_REQUIRED to true only after a users document is available.
FNOL_AUTH_REQUIRED=false
FNOL_AUTH_SECRET_ARN=
FNOL_AUTH_USERS_JSON=
FNOL_COOKIE_SECURE=false

# Bedrock stays off. It cannot change routing or approval.
FNOL_BEDROCK_ENABLED=false
FNOL_BEDROCK_MODEL_ID=

FNOL_RUNTIME_PORT=8767
FNOL_WORKBENCH_PORT=8080
FNOL_LOG_GROUP=
